# Copy with npm run setup to generate a private development .env and .env.local.
# Server settings in .env (never commit credentials):
# NODE_ENV=development
# PORT=3001
# HOST=127.0.0.1
# APP_ORIGIN=http://localhost:5173
# POSTGRES_PASSWORD=<your strong database password>
# POSTGRES_PORT=5433
# DATABASE_URL=postgresql://smartmed:<password>@127.0.0.1:5433/smartmed
# ALLOW_REGISTRATION=true
# Production: NODE_ENV=production, APP_ORIGIN=https://your-domain,
# DATABASE_URL pointing to your PostgreSQL instance, and TRUST_PROXY=1 only behind your proxy.
# Configure PostgreSQL TLS through PGSSLROOTCERT with a trusted CA when required.

# Public browser settings (.env.local); never place secrets in VITE_* variables:
VITE_DATA_MODE=live
VITE_API_BASE_URL=/api/v1
